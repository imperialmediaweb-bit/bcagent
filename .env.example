# === Auth tokens (semnătură HMAC pentru link-uri magice) ===
TOKEN_SECRET=change-me-to-a-long-random-string
ADMIN_SECRET=change-me-too

# === Persistență (Postgres opțional) ===
# Pe Railway: Add service → Database → Postgres. DATABASE_URL e injectat automat.
# Fără DATABASE_URL → fallback la localStorage (datele rămân doar pe device).
# DATABASE_URL=postgres://user:pass@host:5432/db

# === Cloudflare R2 (storage fișiere mari — dataset MF 400MB, poze vizite) ===
# Setup:
#  1. dash.cloudflare.com → R2 → Create bucket (ex: bcagent, locație EU)
#  2. R2 → Manage API Tokens → Create API Token (Object Read & Write pe bucket)
#  3. IMPORTANT — CORS pe bucket (Settings → CORS policy), altfel upload-ul
#     direct din browser eșuează:
#     [{
#       "AllowedOrigins": ["https://APP-UL-TAU.up.railway.app"],
#       "AllowedMethods": ["PUT", "GET"],
#       "AllowedHeaders": ["content-type"],
#       "MaxAgeSeconds": 3600
#     }]
# R2_ACCOUNT_ID=...          # din URL-ul dashboard-ului Cloudflare
# R2_ACCESS_KEY_ID=...       # din API token
# R2_SECRET_ACCESS_KEY=...   # din API token
# R2_BUCKET=bcagent

# === AI Provider ===
# Auto-detect: dacă OPENAI_API_KEY e setat → OpenAI; altfel ANTHROPIC.
# Override explicit cu AI_PROVIDER=openai sau AI_PROVIDER=anthropic.
# AI_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Optional: model OpenAI (default gpt-4o).
# Opțiuni: gpt-4o, gpt-4o-mini (mai ieftin), gpt-4.1, o3-mini, etc.
# OPENAI_MODEL=gpt-4o

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-7

# --- Google Gemini (în viitor) ---
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
